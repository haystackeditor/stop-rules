@@ -0,0 +1,14 @@
+import { statSync } from "node:fs";
+
+/**
+ * Whether a plugin folder is present. A missing folder is the answer to the question,
+ * not a failure, so this returns false for it and lets every other error through.
+ */
+export function pluginInstalled(dir: string): boolean {
+  try {
+    return statSync(dir).isDirectory();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+    throw error;
+  }
+}
