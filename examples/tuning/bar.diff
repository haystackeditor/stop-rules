+import { get } from "./cache.js";
+
+/** A miss and a broken cache both mean "ask the source", which is the caller's next step. */
+export function cached(key: string): string | undefined {
+  try {
+    return get(key);
+  } catch (error) {
+    return undefined;
+  }
+}
