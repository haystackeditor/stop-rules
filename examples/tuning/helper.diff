@@ -0,0 +1,10 @@
+export interface User {
+  id: string;
+  name: string;
+}
+
+export async function loadUser(id: string): Promise<User> {
+  const response = await fetch(`https://api.example.com/users/${id}`);
+  const body = (await response.json()) as User;
+  return body;
+}
