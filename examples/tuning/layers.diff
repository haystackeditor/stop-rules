+import { db } from "../db.js";
+
+export async function monthlyTotal(month: string): Promise<number> {
+  const rows = await db.query("select sum(total) as total from orders where month = $1", [
+    month,
+  ]);
+  return Number(rows[0]?.total ?? 0);
+}
