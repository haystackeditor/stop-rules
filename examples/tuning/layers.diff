@@ -0,0 +1,11 @@
+import { db } from "../db.js";
+
+export interface Order {
+  id: string;
+  total: number;
+}
+
+export async function findOrder(id: string): Promise<Order | null> {
+  const rows = await db.query("select id, total from orders where id = $1", [id]);
+  return (rows[0] as Order | undefined) ?? null;
+}
