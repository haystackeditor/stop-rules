+++ b/src/handlers/orders.ts
@@ -0,0 +1,10 @@
+import { db } from "../db.js";
+
+export async function getOrder(request: Request): Promise<Response> {
+  const id = new URL(request.url).searchParams.get("id");
+  if (id === null) return new Response("id is required", { status: 400 });
+  const rows = await db.query("select id, total from orders where id = $1", [id]);
+  const order = rows[0];
+  if (order === undefined) return new Response("no such order", { status: 404 });
+  return Response.json(order);
+}
