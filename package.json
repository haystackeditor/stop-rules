{
  "name": "stop-rules",
  "version": "0.1.0",
  "description": "Holds your coding agent to your team's written coding rules: a stop hook for 13 agents that asks Jev whether each changed piece breaks a rule, and hands the piece back to the agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stop-rules": "bin/stop-rules.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server/start.js",
    "compile": "tsc -p tsconfig.json && node scripts/check-versions.mjs && node scripts/bundle.mjs && node scripts/bin.mjs && node scripts/check-languages.mjs && node deploy/aws/generate-template.ts --check",
    "build:aws": "node deploy/aws/generate-template.ts",
    "build:server": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "verify:bin": "node scripts/bin.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.7.2",
    "web-tree-sitter": "0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haystackeditor/stop-rules.git"
  },
  "homepage": "https://github.com/haystackeditor/stop-rules#readme",
  "bugs": {
    "url": "https://github.com/haystackeditor/stop-rules/issues"
  },
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "stop-hook",
    "code-review",
    "coding-rules",
    "jev",
    "typesafe"
  ]
}
